{
  "name": "pi-route",
  "version": "0.7.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./serve": "./src/serve.ts"
  },
  "bin": {
    "pi-route": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/serve.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "check": "bun run lint && tsc --noEmit",
    "test": "bun test --timeout 20000",
    "test:watch": "bun test --watch --timeout 20000",
    "test:isolate": "bun test --isolate",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged",
    "pre-push": "bun run check"
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@hono/otel": "^1.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "cac": "^7.1.0",
    "hono": "^4.13.13",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  }
}
